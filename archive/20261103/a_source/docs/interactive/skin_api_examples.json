{
  "schema": "interactive-segmentation-api-examples-v1",
  "model": "skin",
  "endpoint": "POST /api/skin/predict",
  "content_type": "application/json",
  "request_envelope": {
    "image": "<BASE64_IMAGE_PLACEHOLDER>",
    "filename": "image.png",
    "parameters": {}
  },
  "notes": [
    "image 为占位符，本文件不含任何图像数据或令牌",
    "parameters 允许字段：variant / backend / target_class / threshold / roi / box / points",
    "皮肤接口 variant 仅 delivery；target_class 固定 1（皮肤病灶前景）",
    "threshold 默认 0.45，须满足 0 < threshold < 1",
    "坐标一律为原图像素（原始图像坐标），roi/box 右下边界不包含",
    "points 每项为 {x, y, label}，label 为 foreground 或 background，最多 128 点",
    "box 与 points 必须位于 roi 内；前景点必须位于 box 内（若给出 box）",
    "roi 与 box 都要求至少 2x2 像素"
  ],
  "examples": {
    "plain_threshold": {
      "description": "仅按阈值分割，无 ROI/提示",
      "body": {
        "image": "<BASE64_IMAGE_PLACEHOLDER>",
        "filename": "skin.png",
        "parameters": {"variant": "delivery", "backend": "int8", "target_class": 1, "threshold": 0.45}
      }
    },
    "roi_only": {
      "description": "限定 ROI 推理，区域外按背景输出",
      "body": {
        "image": "<BASE64_IMAGE_PLACEHOLDER>",
        "filename": "skin.png",
        "parameters": {"variant": "delivery", "backend": "int8", "target_class": 1, "threshold": 0.45,
                       "roi": {"x0": 120, "y0": 80, "x1": 380, "y1": 300}}
      }
    },
    "points": {
      "description": "点提示（前景/背景）触发模型辅助图割细化",
      "body": {
        "image": "<BASE64_IMAGE_PLACEHOLDER>",
        "filename": "skin.png",
        "parameters": {"variant": "delivery", "backend": "int8", "target_class": 1, "threshold": 0.45,
                       "points": [{"x": 210, "y": 160, "label": "foreground"},
                                  {"x": 150, "y": 150, "label": "background"}]}
      }
    },
    "box": {
      "description": "框提示（框内为候选前景区域，框本身不进入叠加图）",
      "body": {
        "image": "<BASE64_IMAGE_PLACEHOLDER>",
        "filename": "skin.png",
        "parameters": {"variant": "delivery", "backend": "int8", "target_class": 1, "threshold": 0.45,
                       "box": {"x0": 140, "y0": 100, "x1": 360, "y1": 290}}
      }
    },
    "roi_box_points_threshold": {
      "description": "ROI + 框 + 点 + 自定义阈值组合",
      "body": {
        "image": "<BASE64_IMAGE_PLACEHOLDER>",
        "filename": "skin.png",
        "parameters": {"variant": "delivery", "backend": "int8", "target_class": 1, "threshold": 0.53,
                       "roi": {"x0": 100, "y0": 60, "x1": 420, "y1": 340},
                       "box": {"x0": 140, "y0": 100, "x1": 360, "y1": 290},
                       "points": [{"x": 200, "y": 170, "label": "foreground"},
                                  {"x": 130, "y": 120, "label": "background"}]}
      }
    },
    "fp32_backend": {
      "description": "同一请求改用 FP32 后端",
      "body": {
        "image": "<BASE64_IMAGE_PLACEHOLDER>",
        "filename": "skin.png",
        "parameters": {"variant": "delivery", "backend": "fp32", "target_class": 1, "threshold": 0.45}
      }
    }
  },
  "response_fields": ["request_id", "model", "identity", "image", "parameters", "operation",
                      "refinement", "network_prompt_conditioned", "postprocess", "outputs",
                      "statistics", "reference_available", "accuracy_metrics", "warnings", "elapsed_ms"],
  "capabilities_endpoint": "GET /api/skin/capabilities",
  "health_endpoint": "GET /health"
}
