[Unit]
Description=ACDC V2 standalone board engine
After=network.target pld-acdc.service pld-hub.service pld-web.service pld-camus.service
Conflicts=pld-acdc.service

[Service]
Type=notify
NotifyAccess=main
User=root
RuntimeDirectory=acdc-board-v2
RuntimeDirectoryMode=0770
WorkingDirectory=/home/xilinx/acdc_board_v2/releases/hdmi_surface_20261024
Group=xilinx
UMask=0007
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=VTK_SMP_MAX_THREADS=1
ExecStart=/bin/bash -lc "source /etc/profile; exec env PYTHONPATH=/home/xilinx/acdc_board_v2/releases/hdmi_surface_20261024/v2_deps /usr/local/share/pynq-venv/bin/python3 -m acdc.appliance engine --config /home/xilinx/acdc_board_v2/releases/hdmi_surface_20261024/v2_config.json --app-sha c7131026b1a1f2b6668e34ddc628af0d2c536827ebf8e7380359b27cd985186c"
TimeoutStartSec=180
TimeoutStopSec=90
KillMode=control-group
SendSIGKILL=no
Restart=no

[Install]
WantedBy=multi-user.target
