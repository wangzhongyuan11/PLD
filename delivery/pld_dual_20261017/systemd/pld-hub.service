[Unit]
Description=PLD single-owner dual-model workspace
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/xilinx/jupyter_notebooks/pld/releases/pld_dual_20261017/hub
ExecStart=/usr/local/share/pynq-venv/bin/python3 -u /home/xilinx/jupyter_notebooks/pld/releases/pld_dual_20261017/hub/hub.py --config /home/xilinx/jupyter_notebooks/pld/releases/pld_dual_20261017/hub/config.json
Restart=no
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=1200
UMask=0077

[Install]
WantedBy=multi-user.target
