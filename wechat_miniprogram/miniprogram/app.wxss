/**app.wxss**/
page {
  background: #f4f6f8;
  color: #22313a;
  font-size: 28rpx;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 40, 50, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  color: #7b8a94;
  font-size: 24rpx;
  line-height: 1.6;
}

.primary-btn {
  background: #0f6f5c;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.primary-btn[disabled] {
  background: #b9d6cf;
  color: #fff;
}

.plain-btn {
  background: #eef5f3;
  color: #0f6f5c;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.danger-btn {
  background: #fdeeee;
  color: #b3432f;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-left: 12rpx;
}

.tag-ok { background: #e3f3ed; color: #0f6f5c; }
.tag-warn { background: #fdf3e0; color: #a2701c; }
.tag-err { background: #fdeeee; color: #b3432f; }
.tag-info { background: #e8f0fb; color: #33578f; }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted { color: #7b8a94; }

.mono { font-family: monospace; font-size: 24rpx; }

.divider {
  height: 1rpx;
  background: #e8edf0;
  margin: 20rpx 0;
}

image.view-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #eef1f3;
}

.input {
  background: #f2f5f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 14rpx;
  background: #e6ebee;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 16rpx 0;
}

.progress-fill {
  height: 100%;
  background: #0f6f5c;
  border-radius: 999rpx;
  transition: width 0.4s;
}
