.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tab { flex: 1; }

.tab-on {
  background: #0f6f5c;
  color: #fff;
}

.picked { margin: 20rpx 0; }

.picked-img {
  width: 100%;
  height: 380rpx;
  background: #eef1f3;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
}

.file-name {
  flex: 1;
  font-size: 26rpx;
  word-break: break-all;
}

.file-size { font-size: 22rpx; }

.small { font-size: 24rpx; padding: 6rpx 24rpx; }

.spacing-row { display: flex; gap: 16rpx; }

.spacing-input { flex: 1; }
